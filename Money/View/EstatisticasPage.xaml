<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="Money.Views.EstatisticasPage"
             Title="Análise Anual"
             BackgroundColor="#F5F6FA">

    <VerticalStackLayout Padding="20" Spacing="20">
        <Label Text="Desempenho Mensal" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>

        <Border BackgroundColor="White" Padding="10" HeightRequest="450">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15"/>
            </Border.StrokeShape>
            <lvc:CartesianChart Series="{Binding SeriesGrafico}" XAxes="{Binding XAxes}" />
        </Border>

        <Label Text="Dica: Compare suas entradas e saídas para entender sua margem de lucro mensal." 
               FontSize="12" TextColor="Gray" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
    </VerticalStackLayout>
</ContentPage>